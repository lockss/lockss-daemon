{

  publisher <
    name = IOS Press ;
    info[contract] = 2018 ;
    info[tester] = 8 ;
    info[platform] = Source
  >
    hidden[proxy] = DIRECT
    provider = SAGE Publications

  {

    title <
      name = SAGE IOS Publications Books Source Content
    >

    plugin = org.lockss.plugin.clockss.sageios.ClockssSageIosBooksSourcePlugin
    implicit < status ; status2 ; year ; name ; param[directory] >
    param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/sage-iosbooks-released/

    au < readySource ; crawling ; 2026 ; SAGE IOS Books Source Content 2026_01 ; 2026_01 >
    #No more items. Merging with Sage
  }
  {
    title <
       name = IOS Press Books Source Content
    >

    plugin = org.lockss.plugin.clockss.iospress.ClockssIosPressSourcePlugin
    implicit < status ; status2 ; year ; name ; param[directory] >
    {
    param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/iosbooks-released/

    au < zapped ; finished ; 2018 ; IOS Press Books Source Content 2018 ; 2018 >
    au < zapped ; finished ; 2019 ; IOS Press Books Source Content 2019 ; 2019 >
    au < zapped ; finished ; 2020 ; IOS Press Books Source Content 2020 ; 2020 >
    au < zapped ; finished ; 2021 ; IOS Press Books Source Content 2021 ; 2021 >
    au < readySource ; finished ; 2022 ; IOS Press Books Source Content 2022 ; 2022 >
    #No more AUs. Moving to https.
    }
    {
    param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/iosbooks-released/

    au < readySource ; finished ; 2023 ; IOS Press Books Source Content 2023 ; 2023 >
    au < readySource ; finished ; 2024 ; IOS Press Books Source Content 2024 ; 2024 >
    au < readySource ; finished ; 2025 ; IOS Press Books Source Content 2025 ; 2025 >
    #No more items. Merging with Sage

    }
  }

  {

    title <
       name = IOS Press Source Content
    >

    plugin = org.lockss.plugin.clockss.iospress.ClockssIosPressSourcePlugin
    implicit < status ; status2 ; year ; name ; param[directory] >
    {
    param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/ios-released/

    au < zapped ; finished ; 2018 ; IOS Press Source Content 2018 ; 2018 >
    au < zapped ; finished ; 2019 ; IOS Press Source Content 2019 ; 2019 >
    au < zapped ; finished ; 2020 ; IOS Press Source Content 2020 ; 2020 >
    au < zapped ; finished ; 2021 ; IOS Press Source Content 2021 ; 2021 >
    au < zapped ; finished ; 2022 ; IOS Press Source Content 2022 ; 2022 >
    #No more AUs. Moving to https.
    }
    {
    param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/ios-released/

    au < zapped ; finished ; 2023 ; IOS Press Source Content 2023 ; 2023 >
    au < readySource ; finished ; 2024 ; IOS Press Source Content 2024 ; 2024 >
    au < readySource ; finished ; 2025 ; IOS Press Source Content 2025 ; 2025 >
    #No more items. Merging with Sage

    }
  }

}
