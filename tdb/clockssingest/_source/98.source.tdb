{
  publisher <
    name = 98 ;
    info[contract] = 2011 ;
    info[tester] = S ;
    info[platform] = Source
  >
  hidden[proxy] = DIRECT
  provider = 98

  {
    title <
       name = 98 Book Source Content
    >
    plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewBookSourcePlugin
    implicit < status ; status2 ; year ; name ; param[directory] >

    {
      param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/eastviewbooks-released/

      au < zapped ; finished ; 2021 ; 98 Book Source Content 2021_01 ; 2021_01 >
      au < zapped ; finished ; 2022 ; 98 Book Source Content 2022_01 ; 2022_01 >
      #No more AUs. Moved to https.
    }
    {
      param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/eastviewbooks-released/

      au < readySource ; finished ; 2023 ; 98 Book Source Content 2023_01 ; 2023_01 >
      au < readySource ; finished ; 2024 ; 98 Book Source Content 2024_01 ; 2024_01 >
      au < readySource ; finished ; 2025 ; 98 Book Source Content 2025_01 ; 2025_01 >
      au < readySource ; crawling ; 2026 ; 98 Book Source Content 2026_01 ; 2026_01 >

    }
  }

  {
    title <
       name = 98 Journal Source Content
    >
    plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewDirSourcePlugin
    implicit < status ; status2 ; year ; name ; param[directory] >

    {
      param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/eastview-released/

      au < zapped ; finished ; 2021 ; 98 Journal Source Content 2021_01 ; 2021_01 >
      au < zapped ; finished ; 2021 ; 98 Journal Source Content 2021_02 ; 2021_02 >
      au < zapped ; finished ; 2021 ; 98 Journal Source Content 2021_03 ; 2021_03 >
      au < zapped ; finished ; 2021 ; 98 Journal Source Content 2021_04 ; 2021_04 >
      #No more AUs. Moved to https.
    }
    {
      param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/eastview-released/

      au < expected ; exists ; 2026 ; 98 Journal Source Content 2026_01 ; 2026_01 >

    }
  }

  {
      title <
         name = 98 UDB Source Content
      >
      plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewDatabaseDirSourcePlugin
      implicit < status ; status2 ; year ; name ; param[directory] >

      {
        param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/eastviewudbcom-released/

        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_01 ; 2024_01 >
        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_02 ; 2024_02 >
        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_03 ; 2024_03 >
        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_04 ; 2024_04 >
        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_05 ; 2024_05 >
        au < readySource ; finished ; 2024 ; 98 UDB Source Content 2024_06 ; 2024_06 >
      }
    }

    {
      title <
         name = 98 Database Source Content
      >
        plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewDatabaseDirSourcePlugin
        implicit < status ; status2 ; year ; name ; param[directory] >

        #AUs in production
        param[base_url] = https://clockss-ingest.lockss.org/sourcefiles/eastviewdb-released/

        au < readySource ; finished ; 2025 ; 98 Database Source Content 2025_01 ; 2025_01 >
        au < expected ; exists ; 2026 ; 98 Database Source Content 2026_01 ; 2026_01 >

    }

  {
      title <
         name = 98 Newspaper Source Content
      >

        plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewNewspaperDirSourcePlugin
        param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/eastviewnewspapers-released/
        implicit < status ; status2 ; year ; name ; param[directory] >

        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_01 ; 2022_01 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_02 ; 2022_02 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_03 ; 2022_03 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_04 ; 2022_04 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_05 ; 2022_05 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_06 ; 2022_06 >
        au < zapped ; finished ; 2022 ; 98 Newspaper Source Content 2022_07 ; 2022_07 >
        #No more content expected for this plugin.
  }

  {
    title <
       name = 98 Source Content
    >
      plugin = org.lockss.plugin.clockss.eastview.ClockssEastviewSourcePlugin
      param[base_url] = http://clockss-ingest.lockss.org/sourcefiles/eastview-released/
      implicit < status ; status2 ; year ; name ; param[year] >

      au < zapped ; finished ; 2017 ; 98 Source Content 2017 ; 2017 >
      #No more content expected for this plugin.
  }

}
