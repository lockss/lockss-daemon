{

  publisher <
    name = Menoufia University ;
    info[contract] = 2008 ;
    info[back] = 2008 ;
    info[tester] = 5 ;
    info[platform] = bepress
  >
  provider = bepress
  
  # Do not add any titles with the DigitalCommons/BePress Plugin without approval. Document approval in PD-36.

  {
  
    title <
      name = Menoufia Medical Journal ;
      issn = 1110-2098 ;
      eissn = 2314-6788 
    >
    
    plugin = org.lockss.plugin.bepress.ClockssBerkeleyElectronicPressPlugin 
    #moved from  https://www.menoufia-med-j.com/  to  https://menmj.journals.ekb.eg/
    param[journal_abbr] = journal
    implicit < status ; status2 ; year ; name ; param[volume] ; param[base_url] ; hidden[proxy] >

    au < frozen ; exists ; 2023 ; Menoufia Medical Journal Volume 36 ; 36 ; https://www.menoufia-med-j.com/ ; > #login needed on https://www.menoufia-med-j.com/cgi/viewcontent.cgi?article=1098&context=journal
    au < frozen ; exists ; 2024 ; Menoufia Medical Journal Volume 37 ; 37 ; https://www.menoufia-med-j.com/ ; > #login needed on https://www.menoufia-med-j.com/cgi/viewcontent.cgi?article=1098&context=journal
    au < frozen ; exists ; 2025 ; Menoufia Medical Journal Volume 38 ; 38 ; https://www.menoufia-med-j.com/ ; > #login needed on https://www.menoufia-med-j.com/cgi/viewcontent.cgi?article=1098&context=journal
    au < doNotProcess ; exists ; 2026 ; Menoufia Medical Journal Volume 39 ; 39 ; https://www.menoufia-med-j.com/ ; > #login needed on https://www.menoufia-med-j.com/cgi/viewcontent.cgi?article=1098&context=journal

  }

}
