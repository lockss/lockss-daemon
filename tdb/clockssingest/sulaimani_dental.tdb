{
  publisher <
    name = University of Sulaimani, College of Dentistry ;
    info[contract] = 2026 ;
    info[back] = 2014 ;
    # info[tester] = ;
    info[platform] = Custom - SmartJournal
  >

    plugin = org.lockss.plugin.smartjournal.univsal.ClockssSulaimaniDentalJournalsPlugin
    implicit < status ; status2 ; param[year] ; param[volume] ; name ; hidden[proxy] >

  {
    title <
      name = Sulaimani Dental Journal ;
      issn = 2521-3857 ;
      eissn = 2309-4656
    >

    param[base_url] = https://sdj.univsul.edu.iq/

    au < manifest ; exists ; 2014 ; 1 ; Sulaimani Dental Journal Volume 1 ; >
    au < manifest ; exists ; 2015 ; 2 ; Sulaimani Dental Journal Volume 2 ; >
    au < crawling ; exists ; 2016 ; 3 ; Sulaimani Dental Journal Volume 3 ; >
    au < crawling ; exists ; 2017 ; 4 ; Sulaimani Dental Journal Volume 4 ; >
    au < crawling ; exists ; 2018 ; 5 ; Sulaimani Dental Journal Volume 5 ; >
    au < manifest ; exists ; 2019 ; 6 ; Sulaimani Dental Journal Volume 6 ; >
    au < crawling ; exists ; 2020 ; 7 ; Sulaimani Dental Journal Volume 7 ; >
    au < manifest ; exists ; 2021 ; 8 ; Sulaimani Dental Journal Volume 8 ; >
    au < manifest ; exists ; 2022 ; 9 ; Sulaimani Dental Journal Volume 9 ; >
    au < manifest ; exists ; 2023 ; 10 ; Sulaimani Dental Journal Volume 10 ; >
    au < crawling ; exists ; 2024 ; 11 ; Sulaimani Dental Journal Volume 11 ; >
    au < manifest ; exists ; 2025 ; 12 ; Sulaimani Dental Journal Volume 12 ; >
    au < manifest ; exists ; 2026 ; 13 ; Sulaimani Dental Journal Volume 13 ; >
  }
}
