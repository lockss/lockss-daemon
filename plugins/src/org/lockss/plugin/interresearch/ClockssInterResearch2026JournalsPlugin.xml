    </entry>
    <entry>
        <string>plugin_identifier</string>
        <string>org.lockss.plugin.interresearch.ClockssInterResearch2026JournalsPlugin</string>
    </entry>
    <entry>
        <string>plugin_name</string>
        <string>Inter-Research Science Publisher 2026 Journals Plugin (CLOCKSS)</string>
    </entry>
    <entry>
